{
  "name": "remit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/lib/library.test.js",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "api": "node dist-server/index.js",
    "worker": "node dist-server/worker.js",
    "dev:all": "node scripts/dev.mjs",
    "test:server": "npm run build:server && node --test dist-server/tests/*.test.js",
    "test:integration": "npm run build:server && node scripts/test-integration.mjs",
    "models:prepare": "npm run build:server && node scripts/prepare-models.mjs",
    "check": "npm run typecheck && npm test && npm run test:server && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@clerk/express": "^2.1.80",
    "@clerk/react": "6.17.8",
    "@huggingface/transformers": "^4.3.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.11",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "falkordb": "^6.8.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "lucide-react": "1.58.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "vite": "8.3.4",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15",
    "@types/node": "^26.6.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0"
  }
}
