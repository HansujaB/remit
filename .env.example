# Frontend: this is the only credential exposed to the browser.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend only. Never prefix these with VITE_.
CLERK_SECRET_KEY=
FALKORDB_URL=redis://127.0.0.1:6379
GRAPH_PREFIX=remit_
PORT=5174
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173

# Groq text inference only. Choose a model available to your Groq account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Runs on your server, without an embedding API key. First use downloads weights.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# OCR language packs; add languages such as eng+hin+tam as needed.
OCR_LANGUAGES=eng

# Private Cloudflare R2 bucket. No public bucket URL or browser credentials.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET=remit
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional explicit local storage for automated tests/offline development only.
STORAGE_DIR=.data/files

# Direct Apify Actors. Optional APIFY_<PLATFORM>_TASK_ID is supported instead.
# Input templates depend on each chosen Actor's schema. {{url}} is substituted safely.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
APIFY_INSTAGRAM_INPUT='{"directUrls":["{{url}}"],"resultsType":"posts","resultsLimit":1}'
APIFY_PINTEREST_ACTOR_ID=epctex/pinterest-scraper
APIFY_PINTEREST_INPUT='{"startUrls":["{{url}}"],"maxItems":1,"endPage":1}'
APIFY_X_ACTOR_ID=apidojo/tweet-scraper
APIFY_X_INPUT='{"startUrls":["{{url}}"],"maxItems":1}'
APIFY_MAX_RUN_USD=0.25
YOUTUBE_API_KEY=
# Optional reader-service fallback for public pages.
JINA_API_KEY=

MAX_ITEMS=1000
MAX_CHUNKS=60
MAX_ATTEMPTS=3
WORKER_POLL_MS=3000
