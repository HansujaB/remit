{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "rootDir": "server"
  },
  "include": [
    "server/**/*.ts"
  ]
}